ple.com/*" type="url" name="extra.tools.6.config.url"></div><div class="flex flex-col gap-[6px] "><label for="_r_18_" class="label mb-0">Token<span class="text-muted-foreground font-normal"> (opcional)</span></label><input id="_r_18_" class="text" placeholder="Bearer sk-..." type="text" name="extra.tools.6.config.headers.authorization"></div></div></section><section class="border-border bg-card flex flex-col rounded-[18px] border "><div class="flex items-center justify-between gap-[16px] px-[20px] pt-[18px] "><h2 class="section-title">Qué puede hacer</h2></div><div class="flex flex-col gap-[18px] p-[20px]"><label><div class="label">Métodos</div><button type="button" class="text w-full flex justify-between items-center text-left"><span class="text-foreground">GET, POST, PUT, PATCH, DELETE</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right w-[20px] h-[20px] ml-[12px] text-muted-foreground shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></label></div></section><section class="border-border bg-card flex flex-col rounded-[18px] border "><div class="flex items-center justify-between gap-[16px] px-[20px] pt-[18px] "><h2 class="section-title">Lo que enviamos en cada llamada</h2></div><div class="flex flex-col gap-[18px] p-[20px]"><p class="text-secondary-foreground text-[14px] leading-[1.5]">Se envían los siguientes encabezados HTTP con cada solicitud:</p><ul class="flex flex-wrap gap-[6px]"><li><code class="bg-secondary text-secondary-foreground rounded-[8px] px-[8px] py-[3px] font-mono text-[12px]">organization-id</code></li><li><code class="bg-secondary text-secondary-foreground rounded-[8px] px-[8px] py-[3px] font-mono text-[12px]">organization-address</code></li><li><code class="bg-secondary text-secondary-foreground rounded-[8px] px-[8px] py-[3px] font-mono text-[12px]">con