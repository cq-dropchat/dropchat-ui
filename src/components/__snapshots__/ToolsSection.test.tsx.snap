22px] w-[22px]" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg></button><div class="flex min-w-0 grow flex-col"><h2 class="font-display truncate text-[17px] font-bold tracking-[-0.01em] [font-stretch:112%]">Editar cliente HTTP</h2></div><button type="button" class="hover:bg-muted flex h-[44px] w-[44px] shrink-0 items-center justify-center rounded-full" title="Eliminar" aria-label="Eliminar"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-[20px] w-[20px]" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div><div class="flex grow flex-col overflow-y-auto [scrollbar-gutter:stable] gap-[14px] p-[14px_12px]"><section class="border-border bg-card flex flex-col rounded-[18px] border "><div class="flex items-center justify-between gap-[16px] px-[20px] pt-[18px] "><h2 class="section-title">Conexión</h2></div><div class="flex flex-col gap-[18px] p-[20px]"><div class="flex flex-col gap-[6px] "><label for="_r_f_" class="label mb-0">Nombre</label><span id="_r_f_-hint" class="hint">Cómo lo ves en la lista de herramientas del agente.</span><input id="_r_f_" aria-describedby="_r_f_-hint" class="text" placeholder="Mi cliente HTTP" maxlength="32" type="text" name="extra.tools.3.label"></div><div class="flex flex-col gap-[6px] "><label for="_r_g_" class="label mb-0">URL<span class="text-muted-foreground font-normal"> (opcional)</span></label><span id="_r_g_-hint" class="hint">Si termina en /*, solo se permiten URLs que comiencen con esa base. De lo contrario, debe coincidir exactamente.</span><input id="_r_g_" aria-describedby="_r_g_-hint" class="text" placeholder="https://api.example.com/*" type="url" name="extra.tools.3.config.url"></div><div class="flex flex-col gap-[6px] "><label for="_r_h_" class="label mb-0">Token<span class="text-muted-foreground font-normal"> (opcional)</span></label><input id="_r_h_" class="text" placeholder="Bearer sk-..." type="text" name="extra.tools.3.config.headers.authorization"></div></div></section><section class="border-border bg-card flex flex-col rounded-[18px] border "><div class="flex items-center justify-between gap-[16px] px-[20px] pt-[18px] "><h2 class="section-title">Qué puede hacer</h2></div><div class="flex flex-col gap-[18px] p-[20px]"><label><div class="label">Métodos</div><button type="button" class="text w-full flex justify-between items-center text-left"><span class="text-foreground">GET</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right w-[20px] h-[20px] ml-[12px] text-muted-foreground shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></label></div></section><section class="border-border bg-card flex flex-col rounded-[18px] border "><div class="flex items-center justify-between gap-[16px] px-[20px] pt-[18px] "><h2 class="section-title">Lo que enviamos en cada llamada</h2></div><div class="flex flex-col gap-[18px] p-[20px]"><p class="text-secondary-foreground text-[14px] leading-[1.5]">Se envían los siguientes encabezados HTTP con cada solicitud:</p><ul class="flex flex-wrap gap-[6px]"><li><code class="bg-secondary text-secondary-foreground rounded-[8px] px-[8px] py-[3px] font-mono text-[12px]">organization-id</code></li><li><code class="bg-secondary text-secondary-foreground rounded-[8px] px-[8px] py-[3px] font-mono text-[12px]">organization-address</code></li><li><code class="bg-secondary text-secondary-foreground rounded-[8px] px-[8px] py-[3px] font-mono text-[12px]">conversation-id</code></li><li><code class="bg-sec