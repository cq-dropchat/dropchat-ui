art truncate text-[14px]">https://g.mcp.openbsp.dev/mcp</div></div></div></button><button type="button" title="whatsapp" class="h-[72px] w-full flex text-left rounded-xl group   cursor-pointer hover:bg-accent"><div class="flex items-center pr-[15px] pl-[10px]"><div class="p-[8px] bg-muted rounded-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square w-[24px] h-[24px] text-muted-foreground" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path></svg></div></div><div class="flex min-w-0 grow flex-col justify-center pr-[15px]"><div class="flex items-baseline justify-between"><div class="text-foreground truncate text-[16px]">whatsapp</div></div><div class="mt-[2px] flex items-start justify-between"><div class="text-muted-foreground flex w-full min-w-0 items-start truncate text-[14px]">http://127.0.0.1:54321/functions/v1/mcp</div></div></div></button><button type="button" title="erp" class="h-[72px] w-full flex text-left rounded-xl group   cursor-pointer hover:bg-accent"><div class="flex items-center pr-[15px] pl-[10px]"><div class="p-[8px] bg-muted rounded-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-server w-[24px] h-[24px] text-muted-foreground" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg></div></div><div class="flex min-w-0 grow flex-col justify-center pr-[15px]"><div class="flex items-baseline justify-between"><div class="text-foreground truncate text-[16px]">erp</div></div><div class="mt-[2px] flex items-start justify-between"><div class="text-muted-foreground flex w-full min-w-0 items-start truncate text-[14px]">https://mcp.example.test/mcp</div></div></div></button><button type="button" title="api" class="h-[72px] w-full flex text-left rounded-xl group   cursor-pointer hover:bg-accent"><div class="flex items-center pr-[15px] pl-[10px]"><div class="p-[8px] bg-muted rounded-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe w-[24px] h-[24px] text-muted-foreground" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg></div></div><div class="flex min-w-0 grow flex-col justify-center pr-[15px]"><div class="flex items-baseline justify-between"><div class="text-foreground truncate text-[16px]">api</div></div><div class="mt-[2px] flex items-start justify-between"><div class="text-muted-foreground flex w-full min-w-0 items-start truncate text-[14px]">https://api.example.test</div></div></div></button><button type="button" title="db" class="h-[72px] w-full flex text-left rounded-xl group   cursor-pointer hover:bg-accent"><div class="flex items-center pr-[15px] pl-[10px]"><div class="p-[8px] bg-muted rounded-full"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-database w-[24px] h-[24px] text-muted-foreground" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg></div></div><div class="flex min-w-0 grow flex-col justify-center pr-[15px]"><div class="flex items-baseline justify-between"><div class="text-foreground truncate text-[16px]">db</div></div><div class="mt-[2px] flex items-start justify-between"><div class="text-muted-foreground flex w-full min-w-0 items-start truncate text-[14px]">postgres://db.example.test/shop</div></div></div></button><section class="border-border bg-card flex flex-col rounded-[18px] border mt-[10px]"><div class="flex items-center justify-between gap-[16px] px-[20px] pt-[18px] pb-[12px]"><h2 class="section-title">Incluidas</h2></div><div class="flex flex-col"><p class="text-muted-foreground px-[20px] pb-[12px] text-[13px] leading-[1.5]">No hay nada que configurar: se prenden y listo.</p><label class="flex items-start justify-between gap-[12px] border-border border-t px-[16px] py-[12px] rounded-b-[17px] cursor-pointer"><span class="flex min-w-0 flex-col gap-[3px]"><span class="text-[15px] font-semibold">Calculadora</span><span id="_r_1_-describe" class="text-muted-foreground text-[13px] leading-[1.45]">Para que no se equivoque sumando el total de un pedido.</span></span><div class="relative inline-flex items-center mt-[3px] shrink-0"><input class="peer sr-only" aria-label="Calculadora" aria-describedby="_r_1_-describe" type="checkbox" checked=""><div class="
            w-[36px] h-[20px] 
            bg-muted-foreground
            peer-focus:outline-none 
            rounded-full peer 
            peer-checked:after:translate-x-full 
            rtl:peer-checked:after:-translate-x-full 
            after:content-[''] 
            after:absolute 
            after:top-[2px] 
            after:start-[2px] 
            after:bg-primary-foreground
            after:rounded-full 
            after:h-[16px] 
            after:w-[16px] 
            after:transition-all 
            peer-checked:bg-primary
            cursor-pointer
            
          "></div></div></label></div></section></div><div class="border-border bg-background flex shrink-0 flex-col gap-[8px] border-t px-[16px] pt-[12px] pb-[16px]"><button type="button" class="primary">Listo</button></div></div></div>"
`;

exports[`F29: ToolsSection (characterization) > opens the editor of agenda 1`] = `"<div><button type="button" class="flex w-full justify-between gap-[12px] text-left disabled:opacity-50 border-border hover:bg-accent min-h-[56px] items-center border-t px-[16px] py-[12px] disabled:hover:bg-transparent  "><span class="flex min-w-0 flex-col gap-[4px]"><span class="flex items-center gap-[8px]"><span class="text-[15px] font-semibold">Herramientas</span></span><span class="flex flex-wrap items-center gap-[6px]"><span class="inline-flex shrink-0 items-center gap-[6px] rounded-full px-[10px] py-[4px] text-[12px] font-semibold bg-secondary text-secondary-foreground ">erp</span><span class="inline-flex shrink-0 items-center gap-[6px] rounded-full px-[10px] py-[4px] text-[12px] font-semibold bg-secondary text-secondary-foreground ">agenda</span><span class="inline-flex shrink-0 items-center gap-[6px] rounded-full px-[10px] py-[4px] text-[12px] font-semibold bg-secondary text-secondary-foreground ">whatsapp</span><span class="text-muted-foreground text-[12px]">+3 más</span></span></span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right h-[20px] w-[20px] shrink-0 self-center text-muted-foreground" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button><div class="bg-background absolute inset-0 z-50 flex flex-col"><div class="border-border flex shrink-0 items-center gap-[8px] border-b px-[14px] py-[8px]"><button type="button" aria-label="Volver" title="Volver - Completa los campos requeridos" aria-describedby="drill-back-reason" disabled="" class="hover:bg-muted -ml-[8px] flex h-[44px] w-[44px] shrink-0 items-center justify-center rounded-full disabled:opacity-40 disabled:hover:bg-transparent"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left h-[22px] w-[22px]" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg></button><div class="flex min-w-0 grow flex-col"><h2 class="font-display truncate text-[17px] font-bold tracking-[-0.01em] [font-stretch:112%]">Google Calendar</h2></div><button type="button" class="hover:bg-muted flex h-[44px] w-[44px] shrink-0 items-center justify-center rounded-full" title="Eliminar" aria-label="Eliminar"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 h-[20px] w-[20px]" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></div><span id="drill-back-reason" class="sr-only">Completa los campos requeridos</span><div class="flex grow flex-col overflow-y-auto [scrollbar-gutter:stable] gap-[14px] p-[14px_12px]"><section class="border-border bg-card flex flex-col rounded-[18px] border "><div class="flex items-center justify-between gap-[16px] px-[20px] pt-[18px] "><h2 class="section-title">Conexión</h2></div><div class="flex flex-col gap-[18px] p-[20px]"><div class="flex flex-col gap-[6px] "><label for="_r_9_" class="label mb-0">Nombre</label><span id="_r_9_-hint" class="hint">Cómo lo ves en la lista de herramientas del agente.</span><input id="_r_9_" aria-describedby="_r_9_-hint" class="text" placeholder="Mi calendario" maxlength="32" type="text" name="extra.tools.1.label"></div><div class="flex flex-col items-start gap-[10px]"><span class="hint">Autorizá tu cuenta de Google para que el agente pueda ver y crear eventos en tu calendario.</span><button type="button" class="secondary">Autorizar</button><input type="hidden" name="extra.tools.1.config.headers.authorization"></div></div></section><section class="border-border bg-card flex flex-col rounded-[18px] border "><div class="flex items-center justify-between gap-[16px] px-[20px] pt-[18px] "><h2 class="section-title">Qué puede hacer</h2></div><div class="flex flex-col gap-[18px] p-[20px]"><label><div class="label">Herramientas permitidas</div><button type="button" class="text w-full flex justify-between items-center text-left"><span class="text-foreground">Listar eventos</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right w-[20px] h-[20px] ml-[12px] text-muted-foreground shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button></label></div></section></div></div></div>"`;

